# =====================================================================
# gharchive-lakehouse Environment Configuration
# =====================================================================

# 1. Google Gemini API (for optional silver-labeling and SQL helper)
# Obtain free from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Secret Salt for Actor Pseudonymisation (salted SHA-256)
# Generate a random 32-character string (e.g. using: python -c "import secrets; print(secrets.token_hex(16))")
ACTOR_HASH_SALT=generate_and_paste_a_random_secret_salt_here

# 3. Target Date for GH Archive pipeline (defaults to 2024-06-10)
GHARCHIVE_DATE=2024-06-10

# 4. Phase 2 Docker Stack Credentials (PostgreSQL, Airflow, Metabase)
POSTGRES_USER=lakehouse_user
POSTGRES_PASSWORD=lakehouse_secure_password
POSTGRES_DB=lakehouse_db
POSTGRES_PORT=5432

# Airflow host UID (defaults to 50000 on Linux/Mac, 0 or 50000 on Windows)
AIRFLOW_UID=50000
